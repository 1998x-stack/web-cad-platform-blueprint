{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/webcad/document.v1.schema.json",
  "title": "document.v1.schema.json",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
      "not": {
        "enum": [
          "__proto__",
          "constructor",
          "prototype"
        ]
      }
    },
    "lengthScalar": {
      "oneOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "parameterRef"
          ],
          "properties": {
            "parameterRef": {
              "$ref": "#/$defs/id"
            }
          }
        }
      ]
    },
    "vector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "lengthVector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/lengthScalar"
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "enum": [
            "length",
            "angle",
            "count"
          ]
        },
        "value": {
          "type": "number"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "length"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "exclusiveMinimum": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "count"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      ]
    },
    "feature": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "inputs",
            "originMm",
            "sizeMm"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "const": "box"
            },
            "inputs": {
              "type": "array",
              "minItems": 0,
              "maxItems": 0
            },
            "originMm": {
              "$ref": "#/$defs/vector3"
            },
            "sizeMm": {
              "$ref": "#/$defs/lengthVector3"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "inputs",
            "originMm",
            "radiusMm",
            "heightMm",
            "axis"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "const": "cylinder"
            },
            "inputs": {
              "type": "array",
              "minItems": 0,
              "maxItems": 0
            },
            "originMm": {
              "$ref": "#/$defs/vector3"
            },
            "radiusMm": {
              "$ref": "#/$defs/lengthScalar"
            },
            "heightMm": {
              "$ref": "#/$defs/lengthScalar"
            },
            "axis": {
              "const": "Z"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "inputs",
            "booleanOp"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "const": "boolean"
            },
            "inputs": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "$ref": "#/$defs/id"
              }
            },
            "booleanOp": {
              "enum": [
                "cut",
                "union",
                "intersect"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "inputs",
            "distanceMm"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "const": "extrude"
            },
            "inputs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "$ref": "#/$defs/id"
              }
            },
            "distanceMm": {
              "$ref": "#/$defs/lengthScalar"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "inputs",
            "plane",
            "entities",
            "constraints"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "const": "sketch"
            },
            "inputs": {
              "type": "array",
              "minItems": 0,
              "maxItems": 0
            },
            "plane": {
              "enum": [
                "XY",
                "XZ",
                "YZ"
              ]
            },
            "entities": {
              "type": "array",
              "maxItems": 1000
            },
            "constraints": {
              "type": "array",
              "maxItems": 1000
            }
          }
        }
      ]
    },
    "featurePatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "inputs": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "plane": {
          "enum": [
            "XY",
            "XZ",
            "YZ"
          ]
        },
        "entities": {
          "type": "array",
          "maxItems": 1000
        },
        "constraints": {
          "type": "array",
          "maxItems": 1000
        },
        "distanceMm": {
          "$ref": "#/$defs/lengthScalar"
        },
        "booleanOp": {
          "enum": [
            "cut",
            "union",
            "intersect"
          ]
        },
        "originMm": {
          "$ref": "#/$defs/vector3"
        },
        "sizeMm": {
          "$ref": "#/$defs/lengthVector3"
        },
        "radiusMm": {
          "$ref": "#/$defs/lengthScalar"
        },
        "heightMm": {
          "$ref": "#/$defs/lengthScalar"
        },
        "axis": {
          "const": "Z"
        }
      },
      "minProperties": 1
    },
    "command": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "name",
            "kind",
            "value"
          ],
          "properties": {
            "op": {
              "const": "parameter.set"
            },
            "name": {
              "$ref": "#/$defs/id"
            },
            "kind": {
              "enum": [
                "length",
                "angle",
                "count"
              ]
            },
            "value": {
              "type": "number"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "length"
                  }
                }
              },
              "then": {
                "properties": {
                  "value": {
                    "exclusiveMinimum": 0
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "count"
                  }
                }
              },
              "then": {
                "properties": {
                  "value": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "feature"
          ],
          "properties": {
            "op": {
              "const": "feature.add"
            },
            "feature": {
              "$ref": "#/$defs/feature"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "id",
            "patch"
          ],
          "properties": {
            "op": {
              "const": "feature.update"
            },
            "id": {
              "$ref": "#/$defs/id"
            },
            "patch": {
              "$ref": "#/$defs/featurePatch"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "id"
          ],
          "properties": {
            "op": {
              "const": "feature.remove"
            },
            "id": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "featureId"
          ],
          "properties": {
            "op": {
              "const": "output.set"
            },
            "featureId": {
              "$ref": "#/$defs/id"
            }
          }
        }
      ]
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "documentId",
        "revision",
        "units",
        "parameters",
        "features"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "documentId": {
          "$ref": "#/$defs/id"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "units": {
          "const": "mm"
        },
        "parameters": {
          "type": "object",
          "maxProperties": 2000,
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/parameter"
          }
        },
        "features": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/feature"
          }
        },
        "outputBodyId": {
          "$ref": "#/$defs/id"
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "documentId",
    "revision",
    "units",
    "parameters",
    "features"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "documentId": {
      "$ref": "#/$defs/id"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "units": {
      "const": "mm"
    },
    "parameters": {
      "type": "object",
      "maxProperties": 2000,
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/parameter"
      }
    },
    "features": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/feature"
      }
    },
    "outputBodyId": {
      "$ref": "#/$defs/id"
    }
  }
}
